# ─── Data Source Mode ────────────────────────────────────────────────────────
# "api"     → Groq LLM with full knowledge (no pre-indexed data needed)
# "dataset" → Use pre-indexed ChromaDB documents only
# "hybrid"  → ChromaDB first, Groq fallback if no relevant docs found (RECOMMENDED)
DATA_SOURCE_MODE=hybrid

# ─── Groq API (Primary LLM) ──────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
# ─── LLM Provider Settings (used as fallback if GROQ_API_KEY is not set) ─────
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# ─── Sarvam AI (STT — Optional) ──────────────────────────────────────────────
# Leave empty to use browser Web Speech API for voice recognition
SARVAM_API_KEY=
SARVAM_STT_URL=wss://api.sarvam.ai/speech-to-text-translate/ws
SARVAM_LLM_URL=https://api.sarvam.ai/v1

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=s
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_DIR=data/indexes/embeddings

# ─── Vector Database (ChromaDB) ───────────────────────────────────────────────
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=data/indexes/chromadb
CHROMA_COLLECTION_NAME=rag_documents

# ─── BM25 ─────────────────────────────────────────────────────────────────────
BM25_INDEX_PATH=data/indexes/bm25/bm25_index.pkl
BM25_K1=1.5
BM25_B=0.75

# ─── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=20
RERANK_TOP_K=5
FINAL_TOP_K=5
ENABLE_RERANKER=true
ENABLE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.6
RRF_K=60

# ─── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=512

# ─── Guardrails ───────────────────────────────────────────────────────────────
ENABLE_GUARDRAILS=true
LOW_CONFIDENCE_THRESHOLD=0.30
MIN_RETRIEVAL_DOCS=1
MAX_CONTEXT_TOKENS=3000

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNKING_STRATEGY=adaptive
CHUNK_SIZE=256
CHUNK_OVERLAP=32
CHUNK_MIN_SIZE=64
CHUNK_MAX_SIZE=512

# ─── Dataset (optional, only used when DATA_SOURCE_MODE=dataset or hybrid) ────
DATASET_NAME=ai4bharat/MSMARCO-XL
DATASET_SPLIT=train
DATASET_LANGUAGE=en
DATASET_MAX_DOCS=50000
DATA_DIR=data

# ─── API Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
REQUEST_TIMEOUT_MS=60000
MAX_AUDIO_SIZE_BYTES=10485760
MAX_QUERY_LENGTH=1000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Caching ──────────────────────────────────────────────────────────────────
ENABLE_QUERY_CACHE=true
QUERY_CACHE_SIZE=512
QUERY_CACHE_TTL=600

# ─── Monitoring ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
STORE_AUDIO=false
